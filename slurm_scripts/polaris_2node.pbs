#!/bin/bash

# ── PBS directives ────────────────────────────────────────────────────────────
# These lines look like comments to bash but PBS reads them as job settings.

#PBS -N freedave-trado
#PBS -l select=2:system=polaris
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug
#PBS -A lighthouse-purdue
#PBS -o logs/pbs.out
#PBS -e logs/pbs.err
#PBS -v WANDB_API_KEY

# ── Move to the directory where qsub was called from ─────────────────────────
# Without this, the job runs from your home dir.
cd $PBS_O_WORKDIR

# ── Environment setup ─────────────────────────────────────────────────────────
export HF_HOME=/lus/eagle/projects/lighthouse-purdue/michaelholm/hf_cache
export HF_DATASETS_CACHE=$HF_HOME/datasets
export HF_HUB_CACHE=$HF_HOME/hub
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export PYTHONNOUSERSITE=1

# Set WANDB_API_KEY in your ~/.bashrc to enable wandb. If unset, wandb is disabled.
if [ -z "$WANDB_API_KEY" ]; then
    export WANDB_MODE=disabled
else
    export WANDB_API_KEY
fi

export HTTP_PROXY="http://proxy.alcf.anl.gov:3128"
export HTTPS_PROXY="http://proxy.alcf.anl.gov:3128"
export http_proxy="http://proxy.alcf.anl.gov:3128"
export https_proxy="http://proxy.alcf.anl.gov:3128"
export ftp_proxy="http://proxy.alcf.anl.gov:3128"
export no_proxy="admin,polaris-adminvm-01,localhost,*.cm.polaris.alcf.anl.gov,polaris-*,*.polaris.alcf.anl.gov,*.alcf.anl.gov"

# ── Node/GPU layout ───────────────────────────────────────────────────────────
# PBS_NODEFILE is a file PBS writes containing one line per allocated node.
# We deduplicate with sort -u in case PBS lists a node multiple times.
NNODES=$(sort -u $PBS_NODEFILE | wc -l)
NRANKS_PER_NODE=4                          # Polaris has 4 A100s per node
NGPUS_TOTAL=$((NNODES * NRANKS_PER_NODE))  # 8 total
MASTER_ADDR=$(sort -u $PBS_NODEFILE | head -1)  # First node is the master
MASTER_PORT=12346

echo "Nodes: $NNODES  GPUs per node: $NRANKS_PER_NODE  Total GPUs: $NGPUS_TOTAL"
echo "Master: $MASTER_ADDR"
cat $PBS_NODEFILE

# ── Training config ───────────────────────────────────────────────────────────
DATASET="math"
MODEL_PATH=Gen-Verse/TraDo-4B-Instruct
MODEL_BASENAME=$(basename $MODEL_PATH)
RUN_NAME=${MODEL_BASENAME}_${DATASET}_2node

LOGDIR=/lus/eagle/projects/lighthouse-purdue/michaelholm/logs/${PBS_JOBID}
mkdir -p $LOGDIR logs

# ── Launch ────────────────────────────────────────────────────────────────────
# mpiexec launches one process per node (-n $NNODES, --ppn 1 = 1 process per node).
# Each of those processes runs accelerate launch, which handles the 4 GPUs on
# that node internally.
#
# $PMI_RANK is set by mpiexec for each process: 0 on the first node, 1 on the
# second. This becomes the --machine_rank argument so accelerate knows which
# node it's on.
#
# We pass --main_process_ip and --main_process_port so all nodes know where to
# rendezvous. These override what's in the yaml.

GENERATION_BATCH_SIZE=$((NGPUS_TOTAL * 3))  # per_device_train_batch_size=3, must match global batch

mpiexec -n $NNODES --ppn 1 \
    --hostfile <(sort -u $PBS_NODEFILE) \
    bash -c "
        cd $PBS_O_WORKDIR
        export PYTHONNOUSERSITE=1

        # Poll nvidia-smi every 60s in the background on each node
        while true; do
            echo \"=== \$(hostname) \$(date) ===\" >> $LOGDIR/gpu_usage_\${PMI_RANK}.log
            nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits >> $LOGDIR/gpu_usage_\${PMI_RANK}.log
            sleep 60
        done &

        venvs/torch-clone/bin/accelerate launch \
            --config_file slurm_scripts/accelerate_polaris_2node.yaml \
            --machine_rank \$PMI_RANK \
            --main_process_ip $MASTER_ADDR \
            --main_process_port $MASTER_PORT \
            diffu_grpo_train.py \
            --config slurm_scripts/train_trado.yaml \
            --model_path $MODEL_PATH \
            --dataset $DATASET \
            --run_name $RUN_NAME \
            --output_dir $LOGDIR/checkpoints \
            --generation_batch_size $GENERATION_BATCH_SIZE \
        2>&1 | tee $LOGDIR/rank_\${PMI_RANK}.log
    "
